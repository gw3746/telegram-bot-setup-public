#!/usr/bin/env python3
"""保留 python tg 與直接執行兩種入口，轉入本副本 uv 環境。

Support both python tg and direct execution in this checkout uv environment."""
import os
from pathlib import Path
import sys


def main():
    root = Path(__file__).resolve().parent
    uv = os.environ.get("UV_BIN", "uv")
    os.execvp(uv, [uv, "run", "--project", str(root), "python", str(root / "tg_cli.py"), *sys.argv[1:]])


if __name__ == "__main__":
    main()
